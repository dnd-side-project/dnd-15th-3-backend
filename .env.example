PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=database

# OCI Object Storage (S3 compatible)
# OCI_S3_ENDPOINT is optional. If omitted, it is auto-assembled from OCI_REGION and OCI_NAMESPACE:
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=
OCI_NAMESPACE=
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
OCI_BUCKET_NAME_DEV=momo-bucket-dev
OCI_BUCKET_NAME_PROD=momo-bucket-prod
