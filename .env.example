PORT=3000
CORS_ORIGINS=https://dnd-15th-3-frontend.pages.dev,http://localhost:5173,http://localhost:6006
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=

INVITATION_BASE_URL=https://momo.example/invite

# Optional: set both values to generate meeting questions with OpenAI.
# If both are empty, the curated fallback questions are used.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Generation is asynchronous; allow normal API variance before falling back.
OPENAI_TIMEOUT_MS=15000

# AI course generation (OpenAI)
LLM_TEMPERATURE=1
LLM_MAX_TOKENS=2048

# Database (defaults match the local compose.yaml PostGIS instance)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=momo
DB_DATABASE=momo
DB_SSL=false
DB_SSL_CA=
DB_SYNCHRONIZE=false

# Statistics database (defaults match the local compose.yaml statistics instance)
STATS_DB_HOST=127.0.0.1
STATS_DB_PORT=15433
STATS_DB_USERNAME=postgres
STATS_DB_PASSWORD=momo
STATS_DB_DATABASE=momo_statistics
STATS_DB_SSL=false
STATS_DB_SSL_CA=
STATS_DB_SYNCHRONIZE=false

# Public media storage (OCI Object Storage, S3 compatible)
# Defaults below let the app boot locally without OCI credentials; fill real
# values to use storage. OCI_REGION must be non-empty for S3Client to start.
OCI_REGION=ap-hyderabad-1
OCI_NAMESPACE=
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
MEDIA_BUCKET_NAME=momo-media-dev
MEDIA_PUBLIC_BASE_URL=https://objectstorage.ap-hyderabad-1.oraclecloud.com/n/dev/b/momo-media-dev/o/
