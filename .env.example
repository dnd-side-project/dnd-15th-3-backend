PORT=3000
CORS_ORIGINS=https://dnd-15th-3-frontend.pages.dev,http://localhost:5173,http://localhost:6006
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=
INVITATION_BASE_URL=https://momo.example/invite

# AI course generation (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=1
LLM_MAX_TOKENS=2048

# Database (defaults match the local compose.yaml PostGIS instance)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=momo
DB_DATABASE=momo
DB_SSL=false
DB_SSL_CA=
DB_SYNCHRONIZE=false

# Public media storage (OCI Object Storage, S3 compatible)
# Defaults below let the app boot locally without OCI credentials; fill real
# values to use storage. OCI_REGION must be non-empty for S3Client to start.
OCI_REGION=ap-hyderabad-1
OCI_NAMESPACE=
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
MEDIA_BUCKET_NAME=momo-media-dev
MEDIA_PUBLIC_BASE_URL=https://objectstorage.ap-hyderabad-1.oraclecloud.com/n/dev/b/momo-media-dev/o/
